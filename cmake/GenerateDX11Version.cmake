cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "SOURCE_DIR and OUTPUT_FILE are required")
endif()
if(NOT DEFINED FALLBACK_VERSION)
    set(FALLBACK_VERSION "1.3.16")
endif()
if(NOT DEFINED GIT_EXECUTABLE)
    find_program(GIT_EXECUTABLE git)
endif()
function(dx11_git out)
    if(GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" ${ARGN}
            OUTPUT_VARIABLE result RESULT_VARIABLE status ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
    else()
        set(status 1)
        set(result "")
    endif()
    set(${out} "${result}" PARENT_SCOPE)
    set(${out}_OK FALSE PARENT_SCOPE)
    if(status EQUAL 0)
        set(${out}_OK TRUE PARENT_SCOPE)
    endif()
endfunction()
function(dx11_escape out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" " " value "${value}")
    string(REPLACE "\r" " " value "${value}")
    string(REPLACE "\t" " " value "${value}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

set(tag "${VERSION_TAG}")
dx11_git(head rev-parse --verify HEAD)
if(NOT tag AND head_OK)
    dx11_git(tag describe --tags --match "v[0-9]*" --abbrev=0)
endif()
set(version "${FALLBACK_VERSION}")
if(tag)
    set(version "${tag}")
endif()
if(NOT version MATCHES "^v?([0-9]+)\\.([0-9]+)\\.([0-9]+)(\\.([0-9]+))?$")
    message(FATAL_ERROR "Invalid DX11 version: expected vMAJOR.MINOR.PATCH[.BUILD]")
endif()
set(major "${CMAKE_MATCH_1}")
set(minor "${CMAKE_MATCH_2}")
set(revision "${CMAKE_MATCH_3}")
set(build "${CMAKE_MATCH_5}")
if(build STREQUAL "")
    set(build 0)
endif()
foreach(part major minor revision build)
    string(REGEX REPLACE "^0+" "" normalized "${${part}}")
    if(normalized STREQUAL "")
        set(normalized 0)
    endif()
    string(LENGTH "${normalized}" length)
    if(length GREATER 5 OR normalized GREATER 65535)
        message(FATAL_ERROR "DX11 version components must fit Windows 16-bit fields")
    endif()
    set(${part} "${normalized}")
endforeach()
set(release 0)
set(commit "archive")
if(head_OK)
    dx11_git(commit rev-parse --short=8 HEAD)
    dx11_git(dirty status --porcelain --untracked-files=normal)
    if(tag)
        dx11_git(tag_head rev-parse --verify "${tag}^{commit}")
        dx11_git(ancestor merge-base --is-ancestor "${tag}" HEAD)
        if(NOT tag_head_OK OR NOT ancestor_OK)
            message(FATAL_ERROR "DX11 version tag is not an ancestor of HEAD")
        endif()
        dx11_git(distance rev-list "${tag}..HEAD" --count)
        if(NOT distance_OK OR NOT distance MATCHES "^[0-9]+$")
            message(FATAL_ERROR "Cannot determine DX11 distance from version tag")
        endif()
        math(EXPR build "${build} + ${distance}")
        if(build GREATER 65535)
            message(FATAL_ERROR "DX11 build component exceeds Windows 16-bit field")
        endif()
        if(head STREQUAL tag_head AND dirty_OK AND dirty STREQUAL "")
            set(release 1)
        endif()
    endif()
    if(NOT dirty STREQUAL "")
        string(APPEND commit "-dirty")
    endif()
endif()

set(builder "${BUILDER_OVERRIDE}")
if(builder STREQUAL "")
    set(builder "$ENV{GITHUB_ACTOR}")
endif()
if(builder STREQUAL "")
    dx11_git(builder config --get github.username)
endif()
if(builder STREQUAL "")
    dx11_git(builder config --get user.name)
endif()
if(builder STREQUAL "")
    set(builder "Unknown")
endif()
# Only retain public host/path syntax. Never embed a raw remote, local path,
# userinfo, query, fragment or custom protocol in the version resource.
dx11_git(remote config --get remote.origin.url)
set(url "")
if(remote MATCHES "^git@([A-Za-z0-9.-]+):([^?#]+)$")
    set(url "https://${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
elseif(remote MATCHES "^(https?|ssh)://([^/?#]+)/([^?#]+)$")
    set(authority "${CMAKE_MATCH_2}")
    set(path "${CMAKE_MATCH_3}")
    string(REGEX REPLACE "^.*@" "" authority "${authority}")
    if(authority MATCHES "^[A-Za-z0-9.-]+(:[0-9]+)?$")
        set(url "https://${authority}/${path}")
    endif()
endif()
# A credential-bearing query/fragment is discarded, rather than copied.
if(url STREQUAL "" AND remote MATCHES "^(https?|ssh)://([^/?#]+)/([^?#]+)[?#].*$")
    set(authority "${CMAKE_MATCH_2}")
    set(path "${CMAKE_MATCH_3}")
    string(REGEX REPLACE "^.*@" "" authority "${authority}")
    if(authority MATCHES "^[A-Za-z0-9.-]+(:[0-9]+)?$")
        set(url "https://${authority}/${path}")
    endif()
endif()
string(REGEX REPLACE "\\.git$" "" url "${url}")
dx11_escape(company "Built by ${builder} @ ${commit}")
dx11_escape(comments "${url}")
set(content "// Generated by CMake. Do not edit.\n#define VERSION_MAJOR ${major}\n#define VERSION_MINOR ${minor}\n#define VERSION_REVISION ${revision}\n#define VERSION_BUILD ${build}\n#define DX11_VERSION_IS_RELEASE ${release}\n#define VER_COMPANYNAME_STR \"${company}\"\n#define VER_COMMENTS_STR \"${comments}\"\n")
get_filename_component(output_directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(LOCK "${OUTPUT_FILE}.lock" GUARD PROCESS TIMEOUT 20)
set(previous "")
if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" previous)
endif()
if(NOT previous STREQUAL content)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(temporary "${OUTPUT_FILE}.${nonce}.tmp")
    file(WRITE "${temporary}" "${content}")
    file(RENAME "${temporary}" "${OUTPUT_FILE}")
endif()
